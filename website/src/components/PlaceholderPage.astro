---
/**
 * Temporary content of a page that is not built yet. The issues for the real
 * pages replace it page by page.
 *
 * `page` is the id of the page from `src/structure/pages.ts`.
 */
import { getLanguage } from '../i18n/languages';
import Layout from '../layouts/Layout.astro';
import { getText } from '../text';
import Button from './Button.astro';
import RichText from './RichText.astro';

interface Props {
	page: 'libreOffice' | 'word' | 'legal';
}

const { page } = Astro.props;

// Astro works out the language from the address, using the `i18n` settings in `astro.config.ts`.
const language = getLanguage(Astro.currentLocale);

// All text comes from the text modules in `src/text/`. Until the real text is
// written, each text is a visible placeholder that names its key.
const text = getText(language.key);

// The legal page has no text module, because its text will be Markdown.
// Until then its title is the label of the footer link.
const title = page === 'legal' ? text.labels.footer.legal : text[page].title;
---

<Layout page={page} title={title}>
	<h1>{title}</h1>
	{page !== 'legal' && <p class="lead"><RichText text={text[page].intro} /></p>}

	{
		// The download does not exist yet. So the button only leads to the top of this page.
		(page === 'libreOffice' || page === 'word') && (
			<p>
				<Button href="#main" icon="download">{text.labels.install.download}</Button>
			</p>
		)
	}
</Layout>
