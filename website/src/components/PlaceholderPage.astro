---
/**
 * Temporary page of the scaffold. It shows that the routing per language works.
 * The real layout and pages replace it later.
 */
import { getLanguage, languages } from '../i18n/languages';
import { pageLink } from '../lib/links';
import { getText } from '../text';
import RichText from './RichText.astro';

// Astro works out the language from the address, using the `i18n` settings in `astro.config.ts`.
const language = getLanguage(Astro.currentLocale);

// All text comes from the text modules in `src/text/`. Until the real text is
// written, each text is a visible placeholder that names its key.
const text = getText(language.key);
---

<!doctype html>
<html lang={language.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Frasch Ruchtschriwing</title>
	</head>
	<body>
		<h1>{text.start.title}</h1>
		<p><RichText text={text.start.intro} /></p>
		<p><a href={pageLink(language.key, 'does-not-exist')}>Deliberately broken link for the test in issue 8</a></p>
		<nav>
			<ul>
				{
					languages.map((other) => (
						<li>
							<a
								href={pageLink(other.key)}
								lang={other.htmlLang}
								hreflang={other.htmlLang}
								aria-current={other.key === language.key ? 'page' : undefined}
							>
								{other.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</body>
</html>
