---
/**
 * Temporary page of the scaffold. It shows that the routing per language works.
 * The real layout and pages replace it later.
 */
import { getLanguage, languages, type LanguageKey } from '../i18n/languages';
import { pageLink } from '../lib/links';

// Astro works out the language from the address, using the `i18n` settings in `astro.config.ts`.
const language = getLanguage(Astro.currentLocale);

// TypeScript reports an error if a language is missing here.
// The maintainer writes all North Frisian text. Until then a visible placeholder stands in.
const text: Record<LanguageKey, { heading: string; note: string }> = {
	frr: {
		heading: '[[frr:placeholder-heading]]',
		note: '[[frr:placeholder-note]]',
	},
	de: {
		heading: 'Platzhalterseite',
		note: 'Diese Seite zeigt, dass die deutsche Sprachversion gebaut wird.',
	},
	en: {
		heading: 'Placeholder page',
		note: 'This page shows that the English language version is built.',
	},
};

const { heading, note } = text[language.key];
---

<!doctype html>
<html lang={language.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Frasch Ruchtschriwing</title>
	</head>
	<body>
		<h1>{heading}</h1>
		<p>{note}</p>
		<nav>
			<ul>
				{
					languages.map((other) => (
						<li>
							<a
								href={pageLink(other.key)}
								lang={other.htmlLang}
								hreflang={other.htmlLang}
								aria-current={other.key === language.key ? 'page' : undefined}
							>
								{other.name}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</body>
</html>
