---
/**
 * Temporary content of a page that is not built yet. The issues for the real
 * pages replace it page by page.
 *
 * `page` is the id of the page from `src/structure/pages.ts`.
 */
import { date, version } from 'virtual:release';
import { getLanguage } from '../i18n/languages';
import Layout from '../layouts/Layout.astro';
import { formatDate } from '../lib/formatDate';
import { fileLink } from '../lib/links';
import { downloadPath } from '../structure/downloads';
import { getText } from '../text';
import Button from './Button.astro';
import RichText from './RichText.astro';

interface Props {
	page: 'libreOffice' | 'word';
}

const { page } = Astro.props;

// Astro works out the language from the address, using the `i18n` settings in `astro.config.ts`.
const language = getLanguage(Astro.currentLocale);

// All text comes from the text modules in `src/text/`. Until the real text is
// written, each text is a visible placeholder that names its key.
const text = getText(language.key);
const title = text[page].title;
---

<Layout page={page} title={title}>
	<h1>{title}</h1>
	<p class="lead"><RichText text={text[page].intro} /></p>

	{/* The file and the version come from `spell_check/`, see `integrations/downloads.ts`. */}
	<p>
		<Button href={fileLink(downloadPath(page))} icon="download" download>{text.labels.install.download}</Button>
	</p>
	<p>
		{text.labels.install.version} {version} · {text.labels.install.date} <time datetime={date}>{formatDate(date)}</time>
	</p>
</Layout>
