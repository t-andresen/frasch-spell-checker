---
/**
 * Tile: a large link card with a title and one short text. The whole card is
 * one link. Put tiles into a `TileGroup`.
 *
 *   <Tile href={pageLink(language.key, 'word')} title={tile.title} text={tile.text} />
 */
import type { Plain } from '../text/types';

interface Props {
	href: string;
	title: Plain;
	text: Plain;
}

const { href, title, text } = Astro.props;
---

<a class="tile" href={href}>
	<h2 class="tile-title">
		<span>{title}</span>
		<svg
			viewBox="0 0 24 24"
			width="24"
			height="24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.25"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M4 12h16M13 5l7 7-7 7" />
		</svg>
	</h2>
	<p class="tile-text">{text}</p>
</a>
